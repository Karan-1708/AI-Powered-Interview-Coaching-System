# --- Security ---
# Shared secret for internal communication between services
# The install script generates a secure random value automatically.
INTERNAL_API_KEY=replace_this_with_a_secure_key

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# Default (localhost only) is fine for local use.
# For a hosted deployment change this to your actual frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://yourapp.example.com
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Infrastructure ---
# URL where the FastAPI backend is running
API_URL=http://127.0.0.1:8000

# URL where the local Ollama instance is running
OLLAMA_HOST=http://127.0.0.1:11434

# --- AI Provider API Keys (Optional) ---
# Set these so the app pre-fills your keys automatically on startup.
# Keys entered in the UI override these values and are saved to vault.json.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
