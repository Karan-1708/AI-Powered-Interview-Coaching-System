# --- Security ---
# Shared secret for internal communication between services
INTERNAL_API_KEY=replace_this_with_a_secure_key

# --- Infrastructure ---
# The base URL for the FastAPI backend (e.g., http://localhost:8000)
API_URL=http://127.0.0.1:8000

# The local endpoint for the Ollama API
OLLAMA_HOST=http://127.0.0.1:11434

# --- AI Provider API Keys (Optional) ---
# Set these so the app pre-fills your keys automatically on startup.
# Keys entered in the UI override these values and are saved to vault.json.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
